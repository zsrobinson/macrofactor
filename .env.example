# MacroFactor client configuration
# Copy to `.env` and fill in. NEVER commit the real .env.

# Long-lived Firebase refresh token for your OWN MacroFactor account.
# Captured once (e.g. by intercepting the app's securetoken response) and reused.
MACROFACTOR_REFRESH_TOKEN=

# Firebase Web API key for the sbs-diet-app project (a client key, not a secret
# server credential, but still kept out of git). Captured alongside the token.
MACROFACTOR_FIREBASE_API_KEY=

# Optional: port for the REST server (default 8787).
PORT=8787

# Optional: path for the append-only mutation audit log (default ./mutations.log.jsonl).
MACROFACTOR_MUTATION_LOG=./mutations.log.jsonl
